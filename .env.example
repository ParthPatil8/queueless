# Copy to .env (never commit .env). All values below are PLACEHOLDERS.
# Local development needs none of these: demo accounts are created automatically.

NODE_ENV=production
PORT=4000

# REQUIRED in production. The server refuses to start without a 12+ character admin password.
ADMIN_USERNAME=change-me-admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Optional staff account (password 12+ characters)
STAFF_USERNAME=change-me-staff
STAFF_PASSWORD=change-me-to-another-long-password

# Where the SQLite file lives. Point this at a persistent disk/volume if your host offers one.
DATABASE_PATH=./backend/data/queueless.db

# Only needed if the frontend is hosted on a DIFFERENT origin than the API (comma-separated, exact origins).
# Leave empty for the default single-service deployment (same origin, CORS closed).
ALLOWED_ORIGINS=

# Rate limits (defaults shown)
LOGIN_RATE_MAX=5
TOKEN_RATE_MAX=20

# Frontend build-time variable (public URL only, never a secret). Leave empty for same-origin deployment.
# VITE_API_URL=
